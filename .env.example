# --- database -------------------------------------------------------------
# Local dev: Postgres 16 via Homebrew. Production: Neon pooled connection string.
DATABASE_URL="postgresql://USER@localhost:5432/mail_triage?schema=public"

# --- auth (Auth.js v5) ----------------------------------------------------
# Signing key for session cookies. Generate with:  npx auth secret
# Use a DIFFERENT value in production than in development.
AUTH_SECRET=""

# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
# These names are not arbitrary — Auth.js v5 discovers the Google provider by them.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only needed locally. On Vercel, Auth.js derives the URL from the deployment, and
# setting this wrong is a common cause of redirect_uri_mismatch.
AUTH_URL="http://localhost:3000"

# --- object storage -------------------------------------------------------
# Local dev leaves these blank and files go to .storage/ on disk.
# Production: Cloudflare R2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="mail-triage-docs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
