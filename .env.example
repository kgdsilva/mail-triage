# --- database -------------------------------------------------------------
# Local dev: Postgres 16 via Homebrew. Production: Neon pooled connection string.
DATABASE_URL="postgresql://USER@localhost:5432/mail_triage?schema=public"

# --- auth (Auth.js) -------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Magic-link email (Resend). Leave blank to use the console-log dev transport.
AUTH_RESEND_KEY=""
EMAIL_FROM="mail-triage@colabservice.com"

# --- object storage -------------------------------------------------------
# Local dev leaves these blank and files go to .storage/ on disk.
# Production: Cloudflare R2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="mail-triage-docs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
